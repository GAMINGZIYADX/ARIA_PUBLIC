# ─────────────────────────────────────────────
# ARIA — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# ── Authentication ───────────────────────────
# Password to log into the ARIA web UI. Leave blank to disable auth.
ARIA_PASSWORD=your_secure_password_here

# Flask session secret key. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# ── Ollama (local LLM) ───────────────────────
# URL of your Ollama instance. Default: http://127.0.0.1:11434/v1
OLLAMA_URL=http://127.0.0.1:11434/v1

# Main chat model (must be pulled in Ollama first, e.g. ollama pull qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:14b

# Vision/multimodal model for image understanding (e.g. ollama pull gemma3:4b)
OLLAMA_VISION_MODEL=gemma3:4b

# ── Spotify (optional) ───────────────────────
# Required only if you want ARIA to control Spotify playback.
# Get these from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# Must match the redirect URI set in your Spotify app dashboard.
# NOTE: Spotify banned 'localhost' on 2025-04-09 — use 127.0.0.1.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── Advanced / Optional ──────────────────────
# Set to 1 to suppress all ARIA-initiated proactive messages.
ARIA_SILENT_MODE=0

# Enable Flask debug mode (never use in production).
FLASK_DEBUG=0
